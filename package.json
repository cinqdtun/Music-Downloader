{
	"name": "music_downloader",
	"main": "./dist/main/main.js",
	"version": "0.9.0",
	"description": "",
	"devDependencies": {
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^5.2.0",
		"adm-zip": "^0.6.1",
		"cross-env": "^10.1.0",
		"electron": "^44.1.1",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"shadcn": "^4.20.1",
		"typescript": "^7.0.2"
	},
	"scripts": {
			"clean": "rm -rf ./bin && rm -rf ./dist && rm -rf ./dist-packaged",
			"lint": "tsc --noEmit",
			"dev": "electron-vite dev -w",
			"build:linux": "npm run lint && cross-env TARGET_PLATFORM=linux TARGET_ARCH=x64 electron-vite build",
			"package:linux": "npm run clean && npm run build:linux && electron-builder --linux --x64",
			"build:win": "npm run lint && cross-env TARGET_PLATFORM=win32 TARGET_ARCH=x64 electron-vite build",
			"package:win": "npm run clean && npm run build:win && electron-builder --win --x64"
	},
	"keywords": [],
	"author": "5dt1 <contact@5dt1.com>",
	"license": "MIT",
	"build": {
		"appId": "com.5dt1.musicdownloader",
		"productName": "Music Downloader",
		"directories": {
			"output": "dist-packaged"
		},
		"files": [
			"dist/**/*",
			"package.json"
			],
		"extraResources": [
		{
			"from": "bin",
			"to": "bin",
			"filter": [
			"**/*"
			]
		}
		],
		"win": {
			"target": ["nsis"],
			"icon": "assets/icons/icon.ico"
		},
		"linux": {
			"target": [
				"AppImage",
				"deb"
			],
			"category": "AudioVideo",
			"icon": "assets/icons/1024x1024.png"
		}
	},
	"allowScripts": {
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true,
		"electron-winstaller@5.4.0": true
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.2.6",
		"i18next": "^26.4.2",
		"lucide-react": "^1.40.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-i18next": "^17.0.14",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	}
}
